# Copie este arquivo para .env e ajuste os valores.
# O docker compose le automaticamente o .env da raiz do projeto.
#
# DB_URL deve ser o nome do servico "postgres" quando rodando via docker compose.
# Para dev local (./mvnw spring-boot:run) com o postgres publicado na maquina, use localhost:5432.
DB_URL=postgres:5432
DB_USER=usuario
DB_PASSWORD=senha
DB_NAME=meubanco
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
# HS256 exige chave com no minimo 32 bytes (64 hex chars)
JWT_SECRET=troque-por-uma-chave-hmac-sha256-de-32-bytes
GOOGLE_CLIENT_ID=coloque_seu_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=coloque_seu_client_secret_aqui
OAUTH2_ISSUER_URI=https://accounts.google.com